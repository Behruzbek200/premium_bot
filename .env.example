# Never commit real keys/session strings; rotate the previously leaked token.
BOT_TOKEN=YOUR_NEW_BOT_TOKEN
OWNER_ID=123456789
FRAGMENT_API_KEY=
# Polling when empty; use one process with persistent SQLite.
PUBLIC_URL=
DB_PATH=market.sqlite3
PORT=10000
WEBHOOK_SECRET=
# Optional: HUMO Card incoming notification audit; NO UZS auto-credit.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_STRING_SESSION=
HUMO_BOT_USERNAME=HUMOcardbot
HUMO_CARD_LAST4=1382
# Render will inject RENDER_EXTERNAL_URL (auto URL for webhook)
# Render production (paid Starter plan) must use disk + /var/data/market.sqlite3
PERSISTENT_DB_REQUIRED=0
