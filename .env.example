# MAJBURIY — Render environment; do not commit secrets to GitHub.
BOT_TOKEN=PUT_NEW_BOTFATHER_TOKEN_HERE
OWNER_ID=123456789
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
WEBHOOK_SECRET=GENERATE_LONG_RANDOM_PERMANENT_SECRET
# Ixtiyoriy: admin paneldan ham Fragment kalitni kiritish mumkin.
FRAGMENT_API_KEY=
# Admin orqali kiritilgan Fragment kalit shifrlanishi uchun stable qiymat.
# WEBHOOK_SECRET ishlatiladi, agar alohida bo'lsa API_ENCRYPTION_KEY kiriting.
API_ENCRYPTION_KEY=
# Telethon: aliases API_ID, API_HASH ham qabul qilinadi.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_STRING_SESSION=
HUMO_BOT_USERNAME=HUMOcardbot
HUMO_CARD_LAST4=
# Render supplies automatically:
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
# PORT=10000
# PYTHON_VERSION=3.12.9

# Gift'dagi HUMO bank-bot xabari bilan ishlovchi USUL (default: admin ko'rib tasdiqlaydi).
# Rasmiy bank webhook o'rnini bosmaydi, avto-kredit bank xabariga ishonadi.
HUMO_AUTO_CREDIT=0

# V10 DEMO: Stars/Premium/Gift uchun HUMO wallet checkout Telegram
# raqamli mahsulotlar savdo qoidalariga mos emas. Public savdoda ishlatmang.
# Real bankdan tasdiqlangan payment webhook talab qilinadi.
